# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB instance, not Atlas)
MONGO_URI=mongodb://localhost:27017/warden

# CORS - comma-separated list of allowed local network origins.
# http://localhost:5173 is the Vite dev server default; add your LAN IP
# (e.g. http://192.168.1.50:5173) if testing from another device.
CORS_ORIGINS=http://localhost:5173

# Optional. The server auto-detects its own LAN IPv4 address at request
# time (server/utils/lanIp.js, via os.networkInterfaces()) for phone
# pairing's QR code and network share links, so this normally doesn't
# need to be set at all. Set LAN_IP (no protocol, no port - just the
# address, e.g. 192.168.1.50) only to manually override auto-detection,
# e.g. if it ever picks the wrong interface on a machine with several.
# LAN_IP=192.168.1.50

# Auth (placeholder - used once auth is implemented)
JWT_SECRET=changeme

# Encryption (placeholder - used once encryption utils are implemented)
ENCRYPTION_KEY=changeme
