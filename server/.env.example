# Server
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas (or any Mongo URI). Required; the server fails
# loudly at startup if this isn't set. There is no localhost fallback.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/warden

# CORS - comma-separated list of allowed origins (local dev origins and/or
# your deployed frontend's real origin).
CORS_ORIGINS=http://localhost:5173

# The app's own public origin, used to build every link the server hands
# out: share links and the verification / password-reset emails. It is never
# taken from request headers (Host / X-Forwarded-Host can be spoofed).
# REQUIRED in production (NODE_ENV=production, or on Vercel) and the server
# refuses to start without it. Must be an https origin - no path, no query,
# no username or password - e.g. https://warden.example.com. In development,
# if it is unset, links fall back to https://localhost:5173 and the startup log
# says so.
# PUBLIC_APP_URL=https://warden.example.com

# How many reverse proxies sit in front of the API (they set
# X-Forwarded-For). Leave unset: it's 1 on Vercel and 0 everywhere else. Set
# it only for another deployment - e.g. 1 behind nginx. A wrong value either
# puts every visitor in one rate-limit bucket (too low) or lets a client
# choose its own IP (too high, or any value with no proxy at all).
# TRUST_PROXY_HOPS=1

# Signup mode: "open" (anyone can sign up; any submitted code is ignored) or
# "invite" (the sign-up form's "Invite code" field is required and must match
# INVITE_CODE). Only the exact value "open" opens sign-up: unset, "invite" or
# any typo means invite. The check runs on the server before anything else, and
# wrong attempts are rate limited per IP (5 per 15 minutes, 20 per hour).
SIGNUP_MODE=invite
# Required when SIGNUP_MODE=invite. Compared in constant time.
INVITE_CODE=changeme
# In production the server refuses to start unless INVITE_CODE is at least 16
# characters (use a long random string from a password manager).

# Optional. One plain-text line shown on the landing page and the sign-up form in
# invite mode, telling people how to ask for a code, e.g.
#   REQUEST_ACCESS_TEXT=Email sam@example.com to ask for a code.
# Rendered as text (never HTML); control characters are removed and it is cut to
# 200 characters. Never put the invite code itself here: this line is public.
# REQUEST_ACCESS_TEXT=

# Email (Nodemailer over SMTP, e.g. Gmail SMTP). If ANY of these four are
# empty, sendEmail() does not attempt to send - it logs the full email
# (including the verification/reset link) to the server console instead,
# so every auth flow is still exercisable locally with no real mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Warden <no-reply@example.com>

# Login second factor: a 6-digit code is emailed after the password is
# verified. ON by default; the server REFUSES TO START in production with
# OTP_ENABLED=false (it can only be switched off for local development).
# OTP_ENABLED=true
# How long a code (and its login challenge) lasts, in whole minutes (1-60).
# OTP_TTL_MINUTES=5

# Per-account storage quota in MB (default 25). Counts every file in the vault
# plus everything waiting in Trash; emptying Trash, purging and deleting files
# free the space. Encrypted share copies have their own separate limits
# (utils/shareLimits.js). A single upload is also capped at 4MB.
# STORAGE_QUOTA_MB=25

# Vercel Cron secret. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# on the two daily calls in vercel.json "crons": the Trash purge and the document
# expiry REMINDERS. Use a random string of at least 16 characters. Without it
# both endpoints do not exist (404): expired Trash is still removed by the
# database's TTL index, but NO reminder email is sent. You can run the reminder
# job by hand with: node scripts/run-reminders.js
# CRON_SECRET=

# Tamper-evident activity log. Each entry is signed (HMAC-SHA-256) in a chain.
# REQUIRED in production: the server refuses to start without it. At least 32
# random characters; keep it out of the database and the repository.
# AUDIT_HMAC_KEY=
# How many days activity entries are kept (default 30).
# AUDIT_RETENTION_DAYS=30

# Emergency Access (a trusted contact can request read-only access after a waiting period the owner can deny).
# Both are optional.
#
# DEMO ONLY: "true" also allows a 2-minute waiting period. Leave it unset on a real deployment: the normal choices
# are 3, 7 or 14 days.
# EMERGENCY_DEMO_MODE=false
# How many days, after the waiting period ends, the contact can still start a session (whole days, 1 to 30; default 7).
# EMERGENCY_CLAIM_DAYS=7
