# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB instance, not Atlas)
MONGO_URI=mongodb://localhost:27017/warden

# CORS - comma-separated list of allowed local network origins.
# http://localhost:5173 is the Vite dev server default; add your LAN IP
# (e.g. http://192.168.1.50:5173) if testing from another device.
CORS_ORIGINS=http://localhost:5173

# This PC's LAN IP (no protocol, no port - just the address, e.g.
# 192.168.1.50). Required for phone pairing: the QR code POST /api/pair/
# init generates encodes an apiBase built from this, since the phone
# calls the API directly and a server can't reliably determine its own
# LAN-reachable address on a machine with multiple network interfaces.
# Find yours with `ipconfig` (Windows) or `ifconfig`/`ip addr` (Mac/
# Linux) - look for the IPv4 address on your Wi-Fi/Ethernet adapter.
LAN_IP=192.168.100.115

# Auth (placeholder - used once auth is implemented)
JWT_SECRET=changeme

# Encryption (placeholder - used once encryption utils are implemented)
ENCRYPTION_KEY=changeme
